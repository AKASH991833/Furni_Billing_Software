# ============================================================
# License Server - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://license_user:CHANGE_ME@localhost:5432/license_server

# --- Security ---
# Admin credentials for the admin API (no plaintext in code, set here)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=              # SHA-256 of admin password (see README)
# Secret key used to sign admin JWT/session tokens
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS

# --- Signing keys ---
# Ed25519 private key (base64). Generate via: python -m app.crypto.generate_keys
# NEVER commit the real value.
PRIVATE_SIGNING_KEY=             # base64 of Ed25519 private key

# --- Rate limiting ---
RATE_LIMIT_ACTIVATION_PER_MIN=10

# --- Server ---
ENVIRONMENT=development           # development | production
