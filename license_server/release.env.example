# Copy to release.env and fill in real values. NEVER commit release.env.
#
#   cp release.env.example release.env
#   docker compose --env-file release.env up -d --build

# Your domain for the license server (Caddy provisions HTTPS).
APP_DOMAIN=license.yourdomain.com

# PostgreSQL credentials
POSTGRES_DB=license_server
POSTGRES_USER=license_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# License signing key. Generate:
#   cd license_server && python -m app.crypto.generate_keys
PRIVATE_SIGNING_KEY=REPLACE_WITH_PRIVATE_KEY_BASE64

# Admin login
ADMIN_USERNAME=admin
# SHA-256 of the admin password, e.g.:
#   python -c "import hashlib;print(hashlib.sha256(b'YourPassword').hexdigest())"
ADMIN_PASSWORD_HASH=REPLACE_WITH_SHA256_HASH

# Random 64-char secret for signing admin tokens.
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET